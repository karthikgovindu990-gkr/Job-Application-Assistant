{
  "name": "Job Application Autopilot - Groq",
  "nodes": [
    {
      "parameters": {
        "formTitle": "    Job Application Assistant",
        "formDescription": "JobPilot AI simplifies your job application process by analyzing your CV, evaluating job fit, generating a personalized cover letter, tracking your application, and scheduling follow-ups automatically.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Applicant Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Applicant Email",
              "fieldType": "email",
