      "id": "986db529-38f4-4829-9ea5-35982e0f5f97",
      "name": "Application Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -1136,
        192
      ],
      "webhookId": "a7bb670a-91a5-4169-8463-bad1072cb239"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst applicantName = data[\"Applicant Name\"] || \"\";\nconst applicantEmail = data[\"Applicant Email\"] || \"\";\nconst jobTitle = data[\"Job Title\"] || \"\";\nconst companyName = data[\"Company Name\"] || \"\";\nconst jobDescription = data[\"Job Description\"] || \"\";\nconst cvText = data[\"CV / Resume Text\"] || \"\";\n\nconst prompt = `You are an expert recruitment assistant.\n\nEvaluate the candidate against the job description and generate a personalized cover letter.\n\nCandidate name: ${applicantName}\nJob title: ${jobTitle}\nCompany: ${companyName}\n\nJOB DESCRIPTION:\n${jobDescription}\n\nCV / RESUME:\n${cvText}\n\nReturn ONLY valid JSON in this exact structure:\n{\n  \"fit_score\": 0,\n  \"reasoning\": \"short explanation of why the candidate fits or does not fit\",\n  \"strengths\": [\"strength 1\", \"strength 2\", \"strength 3\"],\n  \"gaps\": [\"gap 1\", \"gap 2\"],\n  \"cover_letter\": \"professional personalized cover letter\"\n}\n\nRules:\n- fit_score must be an integer from 0 to 100.\n- Base the score only on the supplied CV and job description.\n- Do not invent qualifications, experience, employers, degrees, or achievements.\n- The cover letter should be concise, professional, and personalized to the company and role.\n- Do not use markdown fences around the JSON.`;\n\nreturn [{\n  json: {\n    applicantName,\n    applicantEmail,\n    jobTitle,\n    companyName,\n    jobDescription,\n    cvText,\n    prompt,\n    submittedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "3811b107-9295-47fd-810f-a7b1ca442c52",
      "name": "Prepare AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -912,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  model: \"openai/gpt-oss-20b\",\n  temperature: 0.2,\n  response_format: {\n    type: \"json_object\"\n  },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are an expert recruitment assistant. Always return valid JSON only.\"\n    },\n    {\n      role: \"user\",\n      content: `Evaluate this job application.\n\nCandidate Name:\n${$json.applicantName}\n\nJob Title:\n${$json.jobTitle}\n\nCompany:\n${$json.companyName}\n\nJOB DESCRIPTION:\n${$json.jobDescription}\n\nCV / RESUME:\n${$json.cvText}\n\nReturn ONLY valid JSON using this structure:\n\n{\n  \"fit_score\": 0,\n  \"reasoning\": \"\",\n  \"strengths\": [],\n  \"gaps\": [],\n  \"cover_letter\": \"\"\n}\n\nRules:\n- fit_score must be an integer between 0 and 100.\n- Compare only the supplied CV and job description.\n- Do not invent qualifications or experience.\n- Generate a professional personalized cover letter.\n- Return JSON only.`\n    }\n  ]\n}\n}}",
        "options": {}
      },
      "id": "f810a0b2-4157-42e7-b11f-566dc8f4c6bf",
      "name": "Groq AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -688,
        192
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "8Cfn3vEZSdbxjcuL",
          "name": "Bearer Auth account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst original = $('Prepare AI Request').first().json;\n\nlet raw = \"\";\nlet success = true;\nlet errorMessage = \"\";\n\nif (input.error) {\n  success = false;\n  errorMessage = input.error.message || JSON.stringify(input.error);\n} else {\n  raw = input.choices?.[0]?.message?.content || input.body?.choices?.[0]?.message?.content || \"\";\n  if (!raw) {\n    success = false;\n    errorMessage = \"Groq returned an empty response.\";\n  }\n}\n\nlet ai = {};\nif (success) {\n  try {\n    ai = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n  } catch (e) {\n    success = false;\n    errorMessage = \"Could not parse Groq JSON response: \" + e.message;\n  }\n}\n\nconst score = Number(ai.fit_score);\nif (success && (!Number.isInteger(score) || score < 0 || score > 100)) {\n  success = false;\n  errorMessage = \"Groq returned an invalid fit score.\";\n}\n\nreturn [{\n  json: {\n    success,\n    errorMessage,\n    applicantName: original.applicantName,\n    applicantEmail: original.applicantEmail,\n    jobTitle: original.jobTitle,\n    companyName: original.companyName,\n    submittedAt: original.submittedAt,\n    fitScore: success ? score : \"\",\n    reasoning: success ? (ai.reasoning || \"\") : \"\",\n    strengths: success ? (ai.strengths || []).join(\", \") : \"\",\n    gaps: success ? (ai.gaps || []).join(\", \") : \"\",\n    coverLetter: success ? (ai.cover_letter || \"\") : \"\"\n  }\n}];"
      },
