        "message": "=Hello {{ $json.applicantName }},<br><br>Your Job Application Autopilot result is ready.<br><br><b>Fit Score:</b> {{ $json.fitScore }}/100<br><b>Reasoning:</b> {{ $json.reasoning }}<br><br><b>Personalized Cover Letter</b><br><br>{{ $json.coverLetter.replace(/\\n/g, '<br>') }}<br><br>Good luck with your application!<br><br>Job Application Autopilot",
        "options": {}
